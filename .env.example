# 请设置随机 JWT 密钥，至少 32 个 UTF-8 字节。
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/relay
SPRING_DATASOURCE_USERNAME=relay
SPRING_DATASOURCE_PASSWORD=REPLACE_WITH_YOUR_DATABASE_PASSWORD
# 默认使用 Redis；demo 配置使用单进程本地推送。
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=
APP_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
