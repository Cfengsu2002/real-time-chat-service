# 请运行 ./scripts/init-env.sh 生成本地 .env；本文件只提供配置说明。
APP_PORT=8080
POSTGRES_DB=chat
POSTGRES_USER=chat
POSTGRES_PASSWORD=REPLACE_WITH_A_RANDOM_PASSWORD
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# 直接运行 Java 服务时使用；Compose 会为容器设置自己的数据库与 Redis 地址。
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/chat
SPRING_DATASOURCE_USERNAME=chat
SPRING_DATASOURCE_PASSWORD=REPLACE_WITH_A_RANDOM_PASSWORD
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
