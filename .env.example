# 复制为 .env 后替换两个占位值。JWT 密钥至少 32 个 UTF-8 字节。
# 例如分别运行 openssl rand -hex 48 和 openssl rand -hex 24 生成随机值。
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET
POSTGRES_PASSWORD=REPLACE_WITH_A_RANDOM_DATABASE_PASSWORD

# Compose 使用新的项目和持久卷，不复用旧版数据库。
POSTGRES_DB=relay_v2
POSTGRES_USER=relay
APP_PORT=18080
APP2_PORT=18081
RELAY_IMAGE=relay-chat:1.0.0
JWT_TTL_SECONDS=86400
APP_ALLOWED_ORIGINS=http://localhost:18080,http://127.0.0.1:18080,http://localhost:18081,http://127.0.0.1:18081

# 不使用 Compose 时，请按本机服务地址设置下列环境变量。
# DATABASE_URL=jdbc:postgresql://localhost:5432/relay_v2
# DATABASE_USERNAME=relay
# DATABASE_PASSWORD=REPLACE_WITH_YOUR_DATABASE_PASSWORD
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# APP_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
